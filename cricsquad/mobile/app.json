{
  "expo": {
    "name": "CricSquad",
    "slug": "cricsquad",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cricsquad",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F3D2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricsquad.app"
    },
    "android": {
      "package": "com.cricsquad.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D2E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "extra": {
      "_comment": "Leave apiBaseUrl empty for the web build so it calls the API same-origin. Set it to the deployed URL when running the native app in Expo Go.",
      "apiBaseUrl": ""
    }
  }
}
