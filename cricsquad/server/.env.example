# PostgreSQL connection string
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/cricsquad"

# Secret used to sign JWTs. Must be set in production.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=4000

# Where uploaded statements and invoice files are written. Swap the storage
# service implementation for S3 later; nothing else needs to change.
UPLOAD_DIR="./uploads"

# Invoice field extraction. When unset, the mock extractor is used so the
# upload flow still works offline and in tests.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
