{
	"appId": "com.crickiq.app",
	"appName": "CrickIQ",
	"webDir": "dist/public",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#16a34a",
			"androidSplashResourceName": "splash",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "Dark",
			"backgroundColor": "#16a34a"
		}
	},
	"android": {
		"minWebViewVersion": 60
	},
	"ios": {
		"limitsNavigationsToAppBoundDomains": false
	},
	"packageClassList": [
		"AppPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
