// CricSquad — cricket team management (Singapore)
// All monetary columns are Decimal(12,2) in SGD. Arithmetic is always done in
// integer cents (see src/lib/money.ts) — never in floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PLAYER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PLAYER)
  // A PLAYER user is linked to their roster entry so they can view own dues.
  playerId     String?  @unique
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  invoiceAudits InvoiceAudit[]
  bulkActions   BulkAction[]
}

// ---------------------------------------------------------------------------
// Roster
// ---------------------------------------------------------------------------

model Player {
  id           String   @id @default(uuid())
  name         String
  mobile       String?
  email        String?
  jerseyNumber Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User?
  squadEntries   MatchSquad[]
  charges        Charge[]
  payments       Payment[]
  statementLines StatementLine[]

  @@index([active])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Fixtures
// ---------------------------------------------------------------------------

model Tournament {
  id        String   @id @default(uuid())
  name      String
  organiser String?
  startDate DateTime
  endDate   DateTime
  venue     String?
  createdAt DateTime @default(now())

  matches  Match[]
  invoices Invoice[]
}

model Match {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  opponent     String
  matchDate    DateTime
  venue        String?
  // Per-player match fee in SGD.
  matchFee     Decimal    @db.Decimal(12, 2)
  // Set once the playing XI is locked in and MATCH_FEE charges are generated.
  squadConfirmedAt DateTime?
  createdAt    DateTime   @default(now())

  squad   MatchSquad[]
  charges Charge[]

  @@index([tournamentId, matchDate])
}

enum SquadRole {
  CAPTAIN
  KEEPER
  PLAYER
  SUB
}

model MatchSquad {
  id       String    @id @default(uuid())
  matchId  String
  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  role     SquadRole @default(PLAYER)

  @@unique([matchId, playerId])
  @@index([matchId])
}

// ---------------------------------------------------------------------------
// Money owed
// ---------------------------------------------------------------------------

enum ChargeType {
  MATCH_FEE
  REGISTRATION_FEE
  JERSEY_FEE
  ADHOC
}

enum ChargeStatus {
  PENDING
  PAID
  WAIVED
}

model Charge {
  id          String       @id @default(uuid())
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        ChargeType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  matchId     String?
  match       Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status      ChargeStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  allocations PaymentAllocation[]

  // A player is charged at most once per match.
  @@unique([playerId, matchId, type])
  @@index([playerId, status])
  @@index([createdAt])
}

enum PaymentMode {
  PAYNOW
  BANK_TRANSFER
  CASH
}

enum PaymentSource {
  MANUAL
  STATEMENT
}

model Payment {
  id           String        @id @default(uuid())
  playerId     String
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  mode         PaymentMode
  reference    String?
  receivedDate DateTime      @default(now())
  source       PaymentSource @default(MANUAL)

  statementUploadId String?
  statementUpload   StatementUpload? @relation(fields: [statementUploadId], references: [id], onDelete: SetNull)
  statementLine     StatementLine?

  // Set when the payment was created by a bulk mark-as-paid, so it can be undone.
  bulkActionId String?
  bulkAction   BulkAction? @relation(fields: [bulkActionId], references: [id], onDelete: SetNull)

  createdAt   DateTime            @default(now())
  allocations PaymentAllocation[]

  @@index([playerId])
  @@index([bulkActionId])
}

model PaymentAllocation {
  id              String  @id @default(uuid())
  paymentId       String
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId        String
  charge          Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountAllocated Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([chargeId])
  @@index([paymentId])
}

// A bulk mark-as-paid run, retained so an admin can undo it within 24 hours.
model BulkAction {
  id            String    @id @default(uuid())
  performedById String
  performedBy   User      @relation(fields: [performedById], references: [id])
  playerCount   Int
  totalAmount   Decimal   @db.Decimal(12, 2)
  chargesCleared Int
  mode          PaymentMode
  reference     String?
  createdAt     DateTime  @default(now())
  undoneAt      DateTime?

  payments Payment[]

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Bank statement reconciliation
// ---------------------------------------------------------------------------

enum StatementStatus {
  PROCESSING
  REVIEWED
  COMPLETED
}

model StatementUpload {
  id            String          @id @default(uuid())
  fileName      String
  storageKey    String?
  uploadedAt    DateTime        @default(now())
  periodFrom    DateTime
  periodTo      DateTime
  status        StatementStatus @default(PROCESSING)
  matchedCount  Int             @default(0)
  unmatchedCount Int            @default(0)
  completedAt   DateTime?

  lines    StatementLine[]
  payments Payment[]
}

enum LineMatchStatus {
  AUTO_MATCHED
  MANUALLY_MATCHED
  UNMATCHED
  IGNORED
}

model StatementLine {
  id                String          @id @default(uuid())
  statementUploadId String
  statementUpload   StatementUpload @relation(fields: [statementUploadId], references: [id], onDelete: Cascade)
  txnDate           DateTime
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  matchStatus       LineMatchStatus @default(UNMATCHED)
  matchedPlayerId   String?
  matchedPlayer     Player?         @relation(fields: [matchedPlayerId], references: [id], onDelete: SetNull)
  // How the auto-matcher arrived at its proposal, shown on the review screen.
  matchReason       String?
  matchConfidence   Int?

  // sha256(txnDate|amount|normalised description) — used to spot a line that
  // was already processed in a prior upload.
  lineHash          String
  duplicateOfLineId String?

  // The payment created when this line was committed at reconciliation.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([statementUploadId, matchStatus])
  @@index([lineHash])
}

// Remembered CSV column mapping, so the admin maps a bank's export only once.
model ColumnMapping {
  id                String   @id @default(uuid())
  bankName          String   @unique
  dateColumn        String
  descriptionColumn String
  creditColumn      String
  debitColumn       String?
  // Some banks split the narrative across several columns (DBS does).
  extraDescriptionColumns String[] @default([])
  dateFormat        String   @default("DD/MM/YYYY")
  headerRowIndex    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceSource {
  UPLOADED
  MANUAL
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum InvoicePaymentMode {
  PAYNOW
  BANK_TRANSFER
  CHEQUE
  CARD
  CASH
}

model Invoice {
  id            String        @id @default(uuid())
  tournamentId  String
  tournament    Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invoiceNumber String
  vendorName    String
  amount        Decimal       @db.Decimal(12, 2)
  gstAmount     Decimal       @db.Decimal(12, 2) @default(0)
  dueDate       DateTime
  fileUrl       String?
  source        InvoiceSource @default(MANUAL)
  status        InvoiceStatus @default(UNPAID)

  txnReference String?
  paymentMode  InvoicePaymentMode?
  paidDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits InvoiceAudit[]

  @@unique([tournamentId, invoiceNumber])
  @@index([tournamentId, status])
}

enum InvoiceAuditAction {
  CREATED
  EDITED
  MARKED_PAID
  REOPENED
}

model InvoiceAudit {
  id        String             @id @default(uuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    InvoiceAuditAction
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  detail    String?
  createdAt DateTime           @default(now())

  @@index([invoiceId, createdAt])
}
